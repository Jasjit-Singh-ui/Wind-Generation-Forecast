{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm ci --prefix frontend --no-audit --no-fund && npm run build --prefix frontend",
  "functions": {
    "backend/app/main.py": {
      "maxDuration": 30,
      "excludeFiles": "{frontend/node_modules/**,frontend/src/**,docs/**,.github/**,backend/tests/**,**/__pycache__/**}"
    }
  }
}
